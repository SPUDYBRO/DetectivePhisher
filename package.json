{
  "name": "DetectivePhisher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api": "uvicorn main:app --reload --app-dir backend --reload-dir backend",
    "start": "concurrently -n Backend,Frontend -c cyan,green \"npm run api\" \"npm run dev\""
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "vite": "^5.4.14"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
